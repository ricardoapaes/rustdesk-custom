# Arquivo de exemplo de variáveis de ambiente para RustDesk Installer Builder
# Copie este arquivo para .env e configure com seus valores reais

# =============================================================================
# CONFIGURAÇÃO OBRIGATÓRIA DO SERVIDOR RUSTDESK
# =============================================================================

# Endereço do servidor ID/Relay do RustDesk
# Exemplo: meuservidor.com ou 192.168.1.100
ID_SERVER_HOST=seu.servidor.com

# Chave de criptografia do servidor RustDesk
# Esta chave é gerada durante a configuração do servidor
ENCRYPTION_KEY=sua_chave_de_criptografia_aqui

# =============================================================================
# CONFIGURAÇÃO OPCIONAL DO INSTALADOR
# =============================================================================

# Nome do aplicativo que aparecerá no instalador
APP_NAME=RustDesk - Sua Empresa

# Versão do instalador personalizado
APP_VERSION=1.0.0

# Nome da empresa/organização (aparece como publisher)
APP_PUBLISHER=Sua Empresa Ltda

# =============================================================================
# INSTRUÇÕES DE USO
# =============================================================================

# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o arquivo .env com suas configurações reais
# 3. Execute: docker-compose up --build
# 4. O instalador será gerado na pasta ./output/

# =============================================================================
# ONDE ENCONTRAR AS INFORMAÇÕES DO SERVIDOR
# =============================================================================

# ID_SERVER_HOST: 
#   - IP ou domínio do seu servidor RustDesk
#   - Exemplo: acesso.minhaempresa.com ou 192.168.1.100

# ENCRYPTION_KEY:
#   - Chave gerada durante a instalação do servidor RustDesk
#   - Localizada normalmente em /opt/rustdesk/id_ed25519.pub no servidor
#   - Ou obtida através do comando: sudo cat /opt/rustdesk/id_ed25519.pub

# Para mais informações sobre configuração do servidor:
# https://rustdesk.com/docs/en/self-host/

# =============================================================================
# EXEMPLOS DE CONFIGURAÇÃO
# =============================================================================

# Exemplo 1: Empresa pequena com IP local
# ID_SERVER_HOST=192.168.1.100
# ENCRYPTION_KEY=abcd1234efgh5678ijkl
# APP_NAME=RustDesk - MinhaEmpresa
# APP_PUBLISHER=MinhaEmpresa Ltda

# Exemplo 2: Empresa com domínio próprio
# ID_SERVER_HOST=acesso.minhaempresa.com
# ENCRYPTION_KEY=xyz789abc123def456ghi
# APP_NAME=Acesso Remoto Corporativo
# APP_PUBLISHER=MinhaEmpresa S.A.

# Exemplo 3: Provedor de TI para cliente
# ID_SERVER_HOST=cliente1.provedorti.com
# ENCRYPTION_KEY=cliente1_key_2024_secure
# APP_NAME=RustDesk - Cliente ABC
# APP_PUBLISHER=Provedor TI Ltda